# Local Ollama is the primary provider and needs no key.
# Override the endpoint here if Ollama isn't on the default port.
OLLAMA_API_BASE=http://localhost:11434

# Set on the Ollama *server* process (e.g. `OLLAMA_NUM_PARALLEL=4 ollama serve`,
# or in the systemd/service env on Windows), not read by this app directly.
# Required for eval runs — see docs/04_EVALUATION.md §0.4-0.5 and ADR-006.
# NUM_PARALLEL must match configs/base.yaml: eval.concurrency (default 4) for
# the harness's semaphore to actually get parallel service instead of queuing.
# KEEP_ALIVE=-1 means never idle-unload the model; without it the harness's
# throughput/latency measurements get corrupted by reload spikes after any
# pause (checkpoint I/O, a slow question).
OLLAMA_NUM_PARALLEL=4
OLLAMA_KEEP_ALIVE=-1

# Optional free-tier overflow providers — only used if Ollama is
# unreachable or rate-limited. Leave blank to skip them entirely.
GROQ_API_KEY=
GEMINI_API_KEY=

# Neo4j 5 (Phase 2, docker/compose.yaml) -- PrimeKG loader + KG-cache
# precompute only (ADR-007). Not read by any eval-time code path. Set a real
# password here in your local, gitignored .env before `docker compose up`;
# NEO4J_PASSWORD has no default and compose will refuse to start without it.
# (bolt URI/user beyond this are set in configs/base.yaml: kg.neo4j_uri/
# kg.neo4j_user, not via env vars.)
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-set-a-real-password-locally
